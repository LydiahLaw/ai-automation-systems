        "responses": {
          "values": [
            {
              "content": "=You are an inbox assistant for Jordan Wells, founder of Brightpath Studio, a small design agency.\n\nRead the email below and return only a JSON object with these keys:\n- \"category\": one of \"Lead\", \"Client\", \"Invoice\", \"Scheduling\", \"Other\"\n- \"priority\": one of \"High\", \"Medium\", \"Low\"\n- \"summary\": one sentence describing what the email needs\n- \"draft_reply\": a short, polite reply draft (3 to 5 sentences) signed \"Jordan\". If the email is a Scheduling request, include the line \"You can book a time here: [CALENDLY_LINK]\". If the email is marketing, spam, or a newsletter, set draft_reply to an empty string.\n\nRules:\n- Use only the exact category and priority values listed above.\n- Do not invent prices, dates, or commitments.\n- Return JSON only, with no extra text.\n- Never use em dashes (—) or en dashes (–). Use commas, periods, or \"and\" instead.\n- Write draft_reply as short paragraphs of 1 to 2 sentences each, separated by a blank line. Never write one long block.\n\nEmail snippet:\n{{ ($('Edit Fields').item.json.text || $('Edit Fields').item.json.html || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 3000) }}\n\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -624,
        256
      ],
      "id": "04d11523-04ef-4b81-86cd-9323ce624204",
